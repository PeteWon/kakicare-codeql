# KakiCare backend — PRODUCTION environment template (used on the EC2).
#
# Copy this file to backend/.env on the EC2 (NOT into the local dev .env),
# replace placeholder values, and never commit it. The .env file is gitignored.
#
# Differences from the dev .env.example:
#   - DEBUG=False (always)
#   - POSTGRES_HOST=db   (Docker service name, not localhost)
#   - URLs point at the public EC2 IP
#   - Cookie-secure flags relaxed because we're on HTTP for now; turn back on
#     when HTTPS is set up.

# --- Core ---
# Generate fresh and keep secret:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

DEBUG=False

# The public IP (and any DNS name you later add). Comma-separated.
ALLOWED_HOSTS=18.221.83.106

# --- PostgreSQL (Docker service name `db`) ---
POSTGRES_DB=kakicare
POSTGRES_USER=kakicare
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security toggles ---
# HTTP-only deployment, so HTTPS-only cookies would never be sent. When you
# switch to HTTPS, REMOVE these two lines (settings.py defaults them to True
# when DEBUG=False).
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- File storage ---
# Inside the container; mounted from a named volume in docker-compose.prod.yml.
MEDIA_ROOT=/app/private_media

# --- Email ---
# Gmail SMTP: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# --- Frontend / CORS / CSRF ---
# nginx serves both frontend and API from the same origin, so CORS isn't
# actually exercised in this deployment — but keep the entries aligned in case
# you split the frontend onto another host later.
FRONTEND_BASE_URL=http://18.221.83.106
CORS_ALLOWED_ORIGINS=http://18.221.83.106
CSRF_TRUSTED_ORIGINS=http://18.221.83.106
