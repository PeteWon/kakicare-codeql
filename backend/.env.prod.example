# KakiCare backend — PRODUCTION environment template (used on the EC2).
#
# Copy this file to backend/.env on the EC2 (NOT into the local dev .env),
# replace placeholder values, and never commit it. The .env file is gitignored.
#
# Differences from the dev .env.example:
#   - DEBUG=False (always)
#   - POSTGRES_HOST=db   (Docker service name, not localhost)
#   - URLs point at the DuckDNS hostname (HTTPS)
#   - Secure cookie flags enabled (SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE)
#   - HSTS enforced for 1 year (SECURE_HSTS_SECONDS)

# --- Core ---
# Generate fresh and keep secret:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

DEBUG=False

# Comma-separated. Must include the DuckDNS hostname (and the raw IP if you
# still want to reach it by IP during troubleshooting).
ALLOWED_HOSTS=kakicare.duckdns.org,18.221.83.106

# --- PostgreSQL (Docker service name `db`) ---
POSTGRES_DB=kakicare
POSTGRES_USER=kakicare
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security toggles (SR-SESS-03) ---
# HTTPS is now live; all cookies must be flagged Secure so the browser only
# sends them over encrypted connections.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# SR-SESS-02: HSTS — 1 year. Set this only after confirming HTTPS works;
# it cannot easily be undone once browsers cache it.
SECURE_HSTS_SECONDS=31536000

# --- File storage ---
# Inside the container; mounted from a named volume in docker-compose.prod.yml.
MEDIA_ROOT=/app/private_media

# --- Email ---
# Gmail SMTP: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# Inbox that public contact-form submissions (POST /api/auth/contact) are sent to.
CONTACT_EMAIL=kakicare18@gmail.com

# --- TOTP encryption ---
# Fernet key used to encrypt TOTP device secrets at rest (SR-DATA, §10.1.2).
# REQUIRED. Generate a fresh key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# --- Field encryption (SR-DATA-05) ---
# Dedicated Fernet key for Senior PII at rest (address, phone, next-of-kin).
# Provision a DISTINCT key from TOTP_ENCRYPTION_KEY in production. Falls back to
# the TOTP key if unset. Generate one with the same command as above.
FIELD_ENCRYPTION_KEY=

# --- Frontend / CORS / CSRF ---
# All origins are now HTTPS. nginx serves both frontend and API from the same
# origin, so CORS isn't exercised in this deployment — keep entries aligned in
# case the frontend moves to a separate host later.
FRONTEND_BASE_URL=https://kakicare.duckdns.org
CORS_ALLOWED_ORIGINS=https://kakicare.duckdns.org
CSRF_TRUSTED_ORIGINS=https://kakicare.duckdns.org
