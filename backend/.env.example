# KakiCare backend environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit a real .env.

# --- Core ---
# Django secret key. REQUIRED. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Debug mode. MUST be False (or unset) in production.
DEBUG=True

# Comma-separated hostnames Django will serve. Required when DEBUG=False.
# Example: ALLOWED_HOSTS=api.kakicare.example,localhost
ALLOWED_HOSTS=

# --- PostgreSQL ---
# These are read by BOTH Django and the Postgres Docker container (see
# docker-compose.yml). POSTGRES_PASSWORD is REQUIRED and must be non-empty —
# the postgres container refuses to initialise without it.
# When running Django natively against the Docker DB, keep POSTGRES_HOST=localhost.
POSTGRES_DB=kakicare
POSTGRES_USER=kakicare
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Security toggles (optional; secure defaults applied when unset) ---
# Default to True in production (DEBUG=False). Set False only for local HTTP dev.
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=31536000

# --- File storage ---
# Absolute path for uploaded volunteer documents. MUST be outside the web root
# in production (SR-DATA-03). Defaults to ../private_media relative to backend/.
# MEDIA_ROOT=/var/lib/kakicare/private_media

# --- Email ---
# For local dev the console backend prints emails to stdout (no SMTP needed).
# For production, switch to an SMTP or transactional provider:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@kakicare.example

# --- Frontend ---
# Base URL of the React app; used when building links in outgoing emails.
FRONTEND_BASE_URL=http://localhost:5173

# --- CORS / CSRF ---
# Comma-separated list of origins the React SPA is served from.
# For production set to the real frontend URL (e.g. https://kakicare.example).
# NEVER use a wildcard alongside CORS_ALLOW_CREDENTIALS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
